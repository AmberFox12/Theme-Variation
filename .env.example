# Minimum 32 caractères aléatoires
JWT_SECRET=changer_cette_cle_secrete_jwt_min_32_chars

# Compte Gmail avec mot de passe d'application (Compte Google > Sécurité)
GMAIL_USER=votre_email@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
